{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexPulse",
  "version": "0.1.23",
  "identifier": "com.codexpulse.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pulse",
        "create": false,
        "title": "CodexPulse",
        "width": 184,
        "height": 36,
        "minWidth": 184,
        "minHeight": 36,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser"
      }
    },
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "Codex usage at a glance",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RTY2MTcyQ0Q4RDkyNTQKUldSVWtvM05jbUhtTkdIL3Izc1BQeDRncW1qNmtSZ1plYjdybHIrc1dNMHloSktXNjFGTE1ma28K",
      "endpoints": ["https://github.com/lvzixun/CodexPulse/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true
    }
  }
}
